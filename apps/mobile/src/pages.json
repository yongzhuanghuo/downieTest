    "autoscan": true,
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": { "navigationStyle": "custom", "navigationBarTitleText": "4KDownle" }
    },
    {
      "path": "pages/downloads/downloads",
      "style": { "navigationBarTitleText": "下载" }
    },
    {
      "path": "pages/mine/mine",
      "style": { "navigationBarTitleText": "我的" }
    },
    {
      "path": "pages/parse/parse",
      "style": { "navigationBarTitleText": "解析结果" }
    },
    {
      "path": "pages/download/download",
      "style": { "navigationBarTitleText": "下载" }
    },
    {
      "path": "pages/delogo/delogo",
      "style": { "navigationBarTitleText": "去水印" }
    },
    {
      "path": "pages/watermark/watermark",
      "style": { "navigationBarTitleText": "加水印" }
    },
    {
      "path": "pages/md5/md5",
