# 后续绑定域名 + 上 HTTPS 时使用（参考，非本次必需）
# 放到 /etc/nginx/sites-available/downie-license 后
#   ln -s /etc/nginx/sites-available/downie-license /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# 证书用 certbot：sudo certbot --nginx -d your-domain.com

server {
    listen 80;
    server_name your-domain.com;   # 换成你的域名

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
